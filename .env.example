# Supabase API Credentials for Beyond the Code
# Found in Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Direct PostgreSQL Connection String for automated migration runner (npm run migrate)
# Found in Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Admin user ID to automatically grant admin rights on migration
ADMIN_USER_ID=
